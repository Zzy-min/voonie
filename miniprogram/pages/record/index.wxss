/* pages/record/index.wxss */
.record-page {
  background-color: #FAF7F0;
  display: flex;
  flex-direction: column;
  padding: 0;
  min-height: 100vh;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.record-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.record-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
}

.record-body {
  flex: 1;
  min-height: 0;
  position: relative;
  z-index: 1;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.header-nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon-svg {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.header-titles {
  display: flex;
  flex-direction: column;
}

.record-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #3D332A;
}

.record-subtitle {
  font-size: 24rpx;
  color: #7A6F64;
  margin-top: 4rpx;
}

/* 灵感胶囊 (贴近案例图文转写气泡) */
.inspiration-box {
  margin-top: 20rpx;
  align-self: flex-end;
  background-color: #FFFCF8;
  border: 1rpx solid #EFE3D2;
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 51, 42, 0.06);
  display: flex;
  align-items: center;
  gap: 14rpx;
  max-width: 92%;
}

.inspiration-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.inspiration-text {
  font-size: 24rpx;
  color: #3D332A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transcribe-tag {
  font-size: 20rpx;
  color: #D9845B;
  font-weight: 500;
}

.inspiration-refresh {
  font-size: 24rpx;
  color: #D9845B;
  flex-shrink: 0;
  padding: 4rpx 8rpx;
}

/* 舞台与小狗 */
.record-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  position: relative;
  z-index: 1;
}

.record-stage.compact .listening-dog-box {
  width: 220rpx;
  height: 228rpx;
  margin-bottom: 8rpx;
}

.listening-dog-box {
  width: 340rpx;
  height: 350rpx;
  margin-bottom: 18rpx;
}

.listening-dog-img {
  width: 100%;
  height: 100%;
}

/* 波形 */
.waveform-container {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 64rpx;
  margin-bottom: 24rpx;
}

.wave-bar {
  width: 8rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #E07A5F, #D9845B);
  border-radius: 9999rpx;
  transition: height 0.15s ease;
}

.wave-bar.active {
  background: linear-gradient(180deg, #E4A968, #D9845B);
}

@keyframes wave1 { 0%, 100% { height: 16rpx; } 50% { height: 48rpx; } }
@keyframes wave2 { 0%, 100% { height: 24rpx; } 50% { height: 56rpx; } }
@keyframes wave3 { 0%, 100% { height: 12rpx; } 50% { height: 40rpx; } }
@keyframes wave4 { 0%, 100% { height: 32rpx; } 50% { height: 64rpx; } }

.anim-wave-1 { animation: wave1 1.1s infinite ease-in-out; }
.anim-wave-2 { animation: wave2 0.9s infinite ease-in-out; }
.anim-wave-3 { animation: wave3 1.3s infinite ease-in-out; }
.anim-wave-4 { animation: wave4 0.8s infinite ease-in-out; }

.timer-box {
  margin-bottom: 12rpx;
}

.timer-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #3D332A;
  letter-spacing: 2rpx;
}

.status-hint {
  font-size: 24rpx;
  color: #ABA094;
}

.retry-upload-btn {
  margin-top: 20rpx;
  padding: 0 34rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #5A4332;
  color: #FFFFFF;
  font-size: 24rpx;
}

.retry-upload-btn::after { border: 0; }

.transcript-card {
  margin: 8rpx 0 24rpx;
  padding: 24rpx;
  border: 1rpx solid #eee3d5;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 28rpx rgba(84, 60, 35, 0.05);
}

.transcript-label {
  display: block;
  margin-bottom: 12rpx;
  color: #7c6a5c;
  font-size: 22rpx;
}

.transcript-textarea {
  width: 100%;
  min-height: 180rpx;
  color: #3e3026;
  font-size: 30rpx;
  line-height: 1.7;
}
.reference-card { margin: 0 0 30rpx; padding: 24rpx; border: 1rpx solid #eee3d5; border-radius: 20rpx; background: #fffdf8; }
.reference-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.reference-title { display: block; color: #3e3026; font-size: 25rpx; font-weight: 650; }
.reference-sub { display: block; margin-top: 5rpx; color: #a89789; font-size: 19rpx; }
.reference-type { flex: none; color: #b8752d; font-size: 21rpx; }
.reference-empty { margin-top: 20rpx; padding: 26rpx; border: 1rpx dashed #dbc9b5; border-radius: 16rpx; color: #7c6a5c; font-size: 23rpx; text-align: center; }
.reference-preview { margin-top: 20rpx; display: flex; align-items: center; gap: 20rpx; }
.reference-preview image { width: 132rpx; height: 104rpx; flex: none; border-radius: 14rpx; }
.reference-actions { display: flex; gap: 28rpx; color: #b8752d; font-size: 22rpx; }
.reference-actions .danger { color: #a94c38; }
.reference-content-option { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #eee3d5; }
.reference-content-option .option-title { display: block; color: #3e3026; font-size: 23rpx; font-weight: 600; }
.reference-content-option .option-sub { display: block; margin-top: 4rpx; color: #a89789; font-size: 19rpx; }
.reference-content-option switch { transform: scale(.82); transform-origin: right center; }

.record-dock {
  position: relative;
  z-index: 2;
  padding: 18rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee3d5;
  background: rgba(250, 247, 240, 0.96);
}

.recording-actions,
.compose-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.dock-btn,
.start-voice-btn,
.send-diary-btn {
  min-height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dock-btn {
  flex: 1;
  background: #fffdf8;
  border: 1rpx solid #eee3d5;
}

.stop-btn {
  background: #5a4332;
}

.stop-btn .dock-btn-title,
.stop-btn .dock-btn-sub { color: #fffdf8; }
.dock-btn-title { color: #3e3026; font-size: 30rpx; font-weight: 650; }
.dock-btn-sub { margin-top: 4rpx; color: #7c6a5c; font-size: 20rpx; }
.stop-btn.disabled { opacity: .45; }

.start-voice-btn {
  width: 180rpx;
  flex: none;
  background: #e8a74c;
  color: #3e3026;
  font-size: 26rpx;
  font-weight: 650;
  gap: 6rpx;
}
.start-voice-btn image { width: 36rpx; height: 36rpx; }
.start-voice-btn.disabled { opacity: .45; }

.send-diary-btn {
  flex: 1;
  background: #eee3d5;
  color: #a89789;
  font-size: 30rpx;
  font-weight: 650;
}
.send-diary-btn.active { background: #e8a74c; color: #3e3026; }

.unified-entry-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 18rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee3d5;
}

.hold-voice-btn {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f1e8;
  transition: transform 120ms ease, background-color 120ms ease;
}

.hold-voice-btn image { width: 34rpx; height: 34rpx; }
.hold-voice-btn.recording { background: #e8a74c; transform: scale(.98); }
.hold-voice-btn.disabled { opacity: .45; }
.recording-dot { width: 24rpx; height: 24rpx; border-radius: 6rpx; background: #fffdf8; }

.text-composer {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  max-height: 190rpx;
  padding: 17rpx 22rpx;
  border: 1rpx solid #eee3d5;
  border-radius: 22rpx;
  background: #fffdf8;
  box-sizing: border-box;
  overflow: hidden;
}

.inline-textarea {
  width: 100%;
  min-height: 42rpx;
  max-height: 150rpx;
  color: #3e3026;
  font-size: 27rpx;
  line-height: 1.55;
}

.inline-send {
  width: 92rpx;
  height: 76rpx;
  flex: none;
  border-radius: 22rpx;
  background: #eee3d5;
  color: #a89789;
  font-size: 24rpx;
  line-height: 76rpx;
  text-align: center;
}

.inline-send.active { background: #e8a74c; color: #3e3026; font-weight: 600; }
.hold-hint { position: absolute; left: 0; bottom: calc(4rpx + env(safe-area-inset-bottom)); width: 76rpx; color: #a89789; font-size: 18rpx; text-align: center; }

/* 底部操作区 */
.record-controls-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 20rpx calc(30rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

.control-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 1rpx solid #E8DFD3;
  box-shadow: 0 6rpx 20rpx rgba(61, 51, 42, 0.06);
  color: #3D332A;
}

.control-action-btn:active {
  transform: scale(0.94);
  background-color: #FAF5ED;
}

.control-action-btn.disabled {
  opacity: 0.32;
  box-shadow: none;
}

.control-action-btn.disabled:active {
  transform: none;
  background-color: #FFFFFF;
}

.action-icon {
  font-size: 36rpx;
}

.btn-subtext {
  font-size: 16rpx;
  color: #7A6F64;
  margin-top: 2rpx;
}

/* 核心“结束了”按键 */
.finish-btn-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-btn-pulse {
  position: absolute;
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  background-color: rgba(61, 51, 42, 0.15);
}

.finish-btn {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5A4332 0%, #3D332A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(61, 51, 42, 0.35);
  border: 4rpx solid #FFFFFF;
  z-index: 2;
  transition: transform 0.15s ease;
}

.finish-btn-wrap:active .finish-btn {
  transform: scale(0.92);
}

.finish-btn-wrap.disabled {
  opacity: 0.65;
  pointer-events: none;
}

.finish-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
