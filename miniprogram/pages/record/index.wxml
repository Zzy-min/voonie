<!-- pages/record/index.wxml -->
<view class="voonie-page voonie-page--no-tab record-page">
  <image class="record-bg" src="/assets/images/ui/ui-bg-record.png" mode="aspectFill" />

  <view class="record-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="back-btn" bindtap="onBack">
        <image class="back-icon-svg" src="/assets/icons/icon-back.svg" mode="aspectFit" />
      </view>
      <view class="header-titles">
        <text class="record-title">{{isRecording ? (isPaused ? '先停一下' : 'Vonnie 在听') : '把今天告诉 Vonnie'}}</text>
        <text class="record-subtitle">{{isRecording ? '可以说完再点完成，中途能暂停' : '先说或先写，文字会保留'}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="record-body" scroll-y>
    <view class="record-stage {{draftText ? 'compact' : ''}}">
      <view class="listening-dog-box">
        <image class="listening-dog-img voonie-mascot voonie-mascot--hero anim-breathe" src="/assets/images/voonie/voonie-listen.png" mode="aspectFit" />
      </view>
      <view class="waveform-container">
        <block wx:for="{{waveAmps}}" wx:key="index">
          <view class="wave-bar {{isRecording && !isPaused ? 'active' : ''}}" style="height: {{item}}rpx;"></view>
        </block>
      </view>
      <view class="timer-box">
        <text class="timer-text">{{durationText}}</text>
      </view>
      <view class="status-hint">
        <text wx:if="{{isUploading}}">正在把语音听写成文字…</text>
        <text wx:elif="{{uploadFailed}}">录音已保存在本机，可重新听写</text>
        <text wx:elif="{{isPaused}}">已暂停，点继续接着说</text>
        <text wx:elif="{{isRecording}}">正在听。想停就点暂停，说完点完成</text>
        <text wx:elif="{{draftText}}">下面是你刚才说的/写的，可以改完再整理</text>
        <text wx:else>点橙色按钮开始说，或直接在下方写</text>
      </view>
      <button wx:if="{{uploadFailed}}" class="retry-upload-btn" loading="{{isUploading}}" disabled="{{isUploading}}" bindtap="onRetryUpload">重新听写</button>
    </view>

    <view class="transcript-card">
      <text class="transcript-label">{{draftText ? '你写下的内容' : '今天想记下的话'}}</text>
      <textarea
        class="transcript-textarea"
        value="{{draftText}}"
        placeholder="这里会显示你说的话，也可以直接写。"
        maxlength="20000"
        auto-height
        show-confirm-bar="false"
        adjust-position
        cursor-spacing="24"
        disabled="{{isRecording || isUploading || textSubmitting}}"
        bindinput="onDraftTextInput"
      />
    </view>
    <view class="reference-card">
      <view class="generation-options">
        <view class="generation-option" bindtap="onChooseStyle"><text>画风</text><text>{{styleLabel}} ›</text></view>
        <view class="generation-option" bindtap="onChooseAspectRatio"><text>图片比例</text><text>{{aspectRatio}} ›</text></view>
      </view>
      <view class="reference-head">
        <view><text class="reference-title">日记参考图</text><text class="reference-sub">最多 3 张，可分别设置用途和正文显示</text></view>
        <text class="reference-type">{{references.length}}/3</text>
      </view>
      <view class="reference-list">
        <view class="reference-item" wx:for="{{references}}" wx:key="key">
          <view class="reference-preview">
            <image src="{{item.path}}" mode="aspectFit" data-key="{{item.key}}" bindtap="onPreviewReference" />
            <text wx:if="{{item.missing}}" class="reference-error">图片已失效，请更换</text>
            <view class="reference-actions">
              <text data-key="{{item.key}}" bindtap="onChooseReference">更换</text>
              <text data-key="{{item.key}}" bindtap="onChooseReferenceType">{{item.typeLabel}} ›</text>
              <text class="danger" data-key="{{item.key}}" bindtap="onRemoveReference">移除</text>
            </view>
          </view>
          <view class="reference-content-option"><text class="option-title">插入日记正文</text><switch checked="{{item.includeInContent}}" disabled="{{textSubmitting}}" color="#E8A74C" data-key="{{item.key}}" bindchange="onReferenceContentChange" /></view>
          <view wx:if="{{item.status === 'uploading'}}" class="reference-progress"><progress percent="{{item.progress}}" stroke-width="3" activeColor="#E8A74C" /><text>上传 {{item.progress}}%</text></view>
          <text wx:elif="{{item.status === 'uploaded'}}" class="reference-uploaded">已上传</text>
          <view wx:elif="{{item.status === 'failed' || item.missing}}" class="reference-error" data-key="{{item.key}}" bindtap="onRetryReference">{{item.missing ? '更换图片' : '上传失败，点按重试'}}</view>
        </view>
      </view>
      <view class="reference-empty" wx:if="{{references.length < 3}}" bindtap="onChooseReference">{{choosingReference ? '正在保存图片…' : '＋ 从相册选择或拍照'}}</view>

    </view>
  </scroll-view>

  <view class="record-dock">
    <view wx:if="{{isRecording}}" class="recording-actions">
      <view class="dock-btn pause-btn" bindtap="onTogglePause" aria-role="button">
        <text class="dock-btn-title">{{isPaused ? '继续' : '暂停'}}</text>
        <text class="dock-btn-sub">{{isPaused ? '接着刚才说' : '先停一下'}}</text>
      </view>
      <view class="dock-btn stop-btn {{isUploading ? 'disabled' : ''}}" bindtap="onFinishRecord" aria-role="button">
        <text class="dock-btn-title">完成</text>
        <text class="dock-btn-sub">听写成文字</text>
      </view>
    </view>
    <view wx:else class="compose-actions">
      <view
        class="start-voice-btn {{isUploading || textSubmitting ? 'disabled' : ''}}"
        bindtap="onPrimaryRecordTap"
        aria-role="button"
        aria-label="开始说话"
      >
        <image src="/assets/icons/icon-mic.svg" mode="aspectFit" />
        <text>开始说</text>
      </view>
      <view class="send-diary-btn {{draftText.length >= 2 && !textSubmitting && !isUploading ? 'active' : ''}}" bindtap="onSubmitText" aria-role="button">
        <text>{{textSubmitting ? '整理中…' : '整理成日记'}}</text>
      </view>
    </view>
  </view>
</view>
