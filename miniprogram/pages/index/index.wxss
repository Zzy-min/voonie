.home-page { background: #FFF9F1; }
.home-header { position: relative; z-index: 4; background: #FFF9F1; }
.header-inner { padding-left: 40rpx; display: flex; align-items: center; justify-content: space-between; }
.date-text, .brand-text { display: block; }
.date-text { font-size: 24rpx; color: #7C6A5C; }
.brand-text { margin-top: 2rpx; font-size: 30rpx; font-weight: 650; color: #3E3026; }
.icon-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.icon-btn image { width: 38rpx; height: 38rpx; }
.home-scroll { flex: 1; min-height: 0; }
.hero { margin: 20rpx 40rpx 0; min-height: 590rpx; position: relative; overflow: hidden; border-radius: 32rpx; background: #FBF2E7; }
.hero-copy { padding: 48rpx 40rpx 0; position: relative; z-index: 2; }
.hero-title { display: block; font-size: 44rpx; line-height: 1.25; font-weight: 650; color: #3E3026; }
.hero-subtitle { display: block; margin-top: 14rpx; font-size: 27rpx; color: #7C6A5C; }
.hero-vonnie { width: 360rpx; height: 310rpx; margin: 8rpx auto 0; }
.heart-burst { position: absolute; top: 190rpx; right: 130rpx; color: #E6B7B0; font-size: 64rpx; }
.primary-record { width: calc(100% - 64rpx); height: 92rpx; margin: -8rpx 32rpx 0; border-radius: 24rpx; background: #E8A74C; color: #3E3026; display: flex; align-items: center; justify-content: center; gap: 14rpx; font-size: 31rpx; font-weight: 600; }
.primary-record:active { transform: scale(.98); background: #D9983C; }
.primary-record image { width: 36rpx; height: 36rpx; }
.draft-notice { margin: 16rpx 32rpx 0; display: flex; justify-content: space-between; color: #7C6A5C; font-size: 24rpx; }
.section { margin: 48rpx 40rpx 0; }
.recent-section { padding-bottom: 52rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; line-height: 1.3; font-weight: 650; color: #3E3026; }
.section-link { font-size: 24rpx; color: #A06D28; }
.state-row, .empty-row, .diary-row, .memory-row { background: #FFFDF8; border-top: 1rpx solid #EEE3D5; border-bottom: 1rpx solid #EEE3D5; }
.state-row { min-height: 116rpx; display: flex; align-items: center; color: #7C6A5C; font-size: 26rpx; }
.state-action { color: #A06D28; }
.empty-row { min-height: 142rpx; display: flex; align-items: center; justify-content: space-between; }
.empty-title, .empty-copy { display: block; }
.empty-title { font-size: 27rpx; font-weight: 550; color: #3E3026; }
.empty-copy { margin-top: 8rpx; font-size: 24rpx; color: #7C6A5C; }
.row-arrow { font-size: 40rpx; color: #A89789; }
.diary-row { min-height: 166rpx; padding: 20rpx 0; display: flex; gap: 22rpx; }
.diary-copy { flex: 1; min-width: 0; }
.diary-mood { display: inline-block; padding: 5rpx 14rpx; border-radius: 999rpx; background: #F8DCA8; color: #6F4C20; font-size: 20rpx; }
.diary-title { display: block; margin-top: 12rpx; font-size: 30rpx; font-weight: 620; color: #3E3026; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.diary-summary, .memory-summary { display: -webkit-box; margin-top: 8rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: #7C6A5C; font-size: 24rpx; line-height: 1.5; }
.diary-cover { width: 150rpx; height: 126rpx; border-radius: 16rpx; background: #F8F1E8; }
.memory-row { padding: 20rpx 0; display: flex; gap: 22rpx; }
.memory-cover { width: 164rpx; height: 128rpx; border-radius: 16rpx; background: #F8F1E8; }
.memory-copy { flex: 1; min-width: 0; }
.memory-date { display: block; font-size: 22rpx; color: #A89789; }
.memory-title { display: block; margin-top: 6rpx; font-size: 28rpx; font-weight: 600; color: #3E3026; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
