<view class="voonie-page home-page">
  <view class="home-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-inner" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <view>
        <text class="date-text">{{currentDateStr}}</text>
        <text class="brand-text">Voling 日记</text>
      </view>
      <view class="icon-btn" bindtap="onNotifyClick">
        <image src="/assets/icons/icon-bell.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <scroll-view class="home-scroll" scroll-y>
    <view class="hero">
      <view class="hero-copy">
        <text class="hero-title">今天过得怎么样？</text>
        <text class="hero-subtitle">告诉 Vonnie，慢慢说就好。</text>
      </view>
      <image class="hero-vonnie voonie-mascot anim-breathe" src="/assets/images/voonie/voonie-sit.png" mode="aspectFit" bindtap="onDogTap" />
      <view wx:if="{{showHeart}}" class="heart-burst">♡</view>
      <button class="primary-record" bindtap="onStartRecord">
        <image src="/assets/icons/icon-mic.svg" mode="aspectFit" />
        <text>说给 Vonnie 听</text>
      </button>
      <view wx:if="{{hasDraft}}" class="draft-notice" bindtap="onResumeDraft">
        <text>有一段记录还没完成</text><text>继续 ›</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head"><text class="section-title">今天的记录</text></view>
      <view wx:if="{{diaryLoading}}" class="state-row"><text>Vonnie 正在翻找今天的故事…</text></view>
      <view wx:elif="{{diaryFailed}}" class="state-row state-action" bindtap="loadHomeDiaries"><text>暂时没取到记录，点此重试</text></view>
      <view wx:elif="{{todayDiary}}" class="diary-row" bindtap="onOpenDiary" data-id="{{todayDiary.id}}">
        <view class="diary-copy">
          <text class="diary-mood">{{todayDiary.mood}}</text>
          <text class="diary-title">{{todayDiary.title}}</text>
          <text class="diary-summary">{{todayDiary.summary || todayDiary.full_content}}</text>
        </view>
        <image wx:if="{{todayDiary.cover}}" class="diary-cover" src="{{todayDiary.cover}}" mode="aspectFill" />
      </view>
      <view wx:else class="empty-row" bindtap="onStartRecord">
        <view><text class="empty-title">Vonnie 还没有收藏今天的故事。</text><text class="empty-copy">说说今天发生了什么吧。</text></view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="section recent-section">
      <view class="section-head"><text class="section-title">最近回忆</text><text class="section-link" bindtap="onOpenMemories">查看全部</text></view>
      <view wx:if="{{recentDiary}}" class="memory-row" bindtap="onOpenDiary" data-id="{{recentDiary.id}}">
        <image class="memory-cover" src="{{recentDiary.cover || '/assets/images/ui/illust-meadow.png'}}" mode="aspectFill" />
        <view class="memory-copy"><text class="memory-date">{{recentDiary.date_label}}</text><text class="memory-title">{{recentDiary.title}}</text><text class="memory-summary">{{recentDiary.summary}}</text></view>
      </view>
      <view wx:else class="state-row"><text>以后回头看，会从这里遇见过去的你。</text></view>
    </view>
  </scroll-view>
</view>
