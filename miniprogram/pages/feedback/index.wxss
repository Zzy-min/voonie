.feedback-page{height:100vh;display:flex;flex-direction:column;background:#fff9f1;overflow:hidden}.page-header{padding-left:40rpx;border-bottom:1rpx solid #eee3d5;background:#fffdf8}.header-nav{position:relative;display:flex;align-items:center;box-sizing:border-box}.back-btn{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}.back-btn image{width:34rpx;height:34rpx}.header-title{position:absolute;left:64rpx;right:0;text-align:center;color:#3e3026;font-size:32rpx;font-weight:650}.feedback-scroll{flex:1;min-height:0;padding:34rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}.lead{display:block;margin-bottom:34rpx;color:#7c6a5c;font-size:24rpx;line-height:1.6}.field{margin-bottom:30rpx}.label{display:block;margin-bottom:12rpx;color:#3e3026;font-size:25rpx;font-weight:600}.picker-value,.contact,.description,.choose-image{width:100%;border:1rpx solid #eee3d5;border-radius:16rpx;background:#fffdf8;box-sizing:border-box}.picker-value,.contact,.choose-image{height:84rpx;padding:0 24rpx;line-height:84rpx;color:#7c6a5c;font-size:24rpx}.picker-value{display:flex;justify-content:space-between}.description{height:260rpx;padding:22rpx 24rpx;color:#3e3026;font-size:26rpx;line-height:1.65}.count{display:block;margin-top:8rpx;text-align:right;color:#a89789;font-size:20rpx}.screenshot-box{display:flex;align-items:center;gap:18rpx;color:#c7842f;font-size:22rpx}.screenshot-box image{width:180rpx;height:130rpx;border-radius:14rpx}.privacy-row{display:flex;align-items:flex-start;gap:12rpx;color:#7c6a5c;font-size:21rpx;line-height:1.5}.check{width:30rpx;height:30rpx;flex:none;border:1rpx solid #d8cabb;border-radius:8rpx;text-align:center;line-height:30rpx}.check.on{background:#e8a74c;color:#3e3026}.submit{height:88rpx;margin-top:34rpx;border-radius:18rpx;background:#e8a74c;color:#3e3026;font-size:27rpx;font-weight:600;line-height:88rpx}.submit::after{border:0}
