<view class="voonie-page voonie-page--no-tab feedback-page">
  <view class="page-header" style="padding-top: {{statusBarHeight}}px;"><view class="header-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;"><view class="back-btn" bindtap="onBack"><image src="/assets/icons/icon-back.svg" mode="aspectFit" /></view><text class="header-title">帮助与反馈</text></view></view>
  <scroll-view class="feedback-scroll" scroll-y>
    <text class="lead">哪里不顺手，告诉我们就好。点击下方按钮，在微信意见反馈页面描述问题。</text>
    <button class="submit" open-type="feedback">打开微信意见反馈</button>
  </scroll-view>
</view>