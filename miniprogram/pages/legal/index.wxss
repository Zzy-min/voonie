.legal-page{height:100vh;display:flex;flex-direction:column;background:#fff9f1;overflow:hidden}.page-header{padding-left:40rpx;border-bottom:1rpx solid #eee3d5;background:#fffdf8}.header-nav{position:relative;display:flex;align-items:center;box-sizing:border-box}.back-btn{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}.back-btn image{width:34rpx;height:34rpx}.header-title{position:absolute;left:64rpx;right:0;text-align:center;color:#3e3026;font-size:32rpx;font-weight:650}.legal-scroll{flex:1;min-height:0;padding:38rpx 44rpx calc(70rpx + env(safe-area-inset-bottom));box-sizing:border-box}.updated{display:block;margin-bottom:34rpx;color:#a89789;font-size:21rpx}.h{display:block;margin:34rpx 0 12rpx;color:#3e3026;font-size:29rpx;font-weight:650}.p{display:block;color:#6f6054;font-size:25rpx;line-height:1.85}
