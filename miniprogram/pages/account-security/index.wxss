.security-page { height: 100vh; min-height: 0; overflow: hidden; background: #fff9f1; }
.security-header { padding: 0 40rpx; border-bottom: 1rpx solid #eee3d5; background: #fffdf8; }
.header-nav { position: relative; display: flex; align-items: center; box-sizing: border-box; }
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-btn image { width: 34rpx; height: 34rpx; }
.header-title { position: absolute; left: 64rpx; right: 0; color: #3e3026; font-size: 32rpx; font-weight: 650; text-align: center; pointer-events: none; }
.security-scroll { flex: 1; min-height: 0; width: 100%; padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.intro-card { padding: 30rpx; border: 1rpx solid #eee3d5; border-radius: 24rpx; background: #fffdf8; }
.intro-title { display: block; color: #3e3026; font-size: 30rpx; font-weight: 650; }
.intro-copy { display: block; margin-top: 10rpx; color: #7c6a5c; font-size: 23rpx; line-height: 1.65; }
.identity-list { margin-top: 28rpx; overflow: hidden; border: 1rpx solid #eee3d5; border-radius: 24rpx; background: #fffdf8; }
.identity-row { min-height: 120rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #f4ece2; }
.identity-row:last-child { border-bottom: 0; }
.identity-icon { width: 64rpx; height: 64rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 22rpx; font-weight: 650; }
.email-icon { color: #6d5a49; background: #f4ebdf; }
.wechat-icon { color: #fff; background: #07c160; }
.phone-icon { color: #6f4b18; background: #f8dca8; font-size: 17rpx; }
.identity-copy { flex: 1; min-width: 0; }
.identity-name { display: block; color: #3e3026; font-size: 27rpx; font-weight: 600; }
.identity-value { display: block; margin-top: 4rpx; overflow: hidden; color: #7c6a5c; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.bound-tag { flex: none; color: #82a96b; font-size: 22rpx; }
.bind-btn { width: 116rpx; height: 62rpx; flex: none; border-radius: 16rpx; background: #e8a74c; color: #3e3026; font-size: 23rpx; line-height: 62rpx; }
.bind-btn::after { border: 0; }
.bind-btn.bound { background: #f4f0e9; color: #a89789; }
.notice-card { margin-top: 28rpx; padding: 24rpx 28rpx; border-left: 4rpx solid #afcbd2; background: rgba(255,253,248,.72); }
.notice-title { display: block; color: #3e3026; font-size: 24rpx; font-weight: 600; }
.notice-copy { display: block; margin-top: 8rpx; color: #7c6a5c; font-size: 22rpx; line-height: 1.65; }
.danger-zone { margin-top: 32rpx; padding: 28rpx; border: 1rpx solid #efd8d1; border-radius: 24rpx; background: #fffdf8; }
.danger-title { display: block; color: #8d3f31; font-size: 26rpx; font-weight: 650; }
.danger-copy { display: block; margin: 10rpx 0 22rpx; color: #7c6a5c; font-size: 22rpx; line-height: 1.6; }
.delete-account-btn { height: 72rpx; border: 1rpx solid #d98772; border-radius: 16rpx; background: transparent; color: #a94c38; font-size: 23rpx; line-height: 70rpx; }
.delete-account-btn::after { border: 0; }
.loading, .error-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22rpx; color: #7c6a5c; font-size: 25rpx; }
.retry-btn { width: 220rpx; height: 72rpx; border-radius: 18rpx; background: #e8a74c; color: #3e3026; font-size: 24rpx; line-height: 72rpx; }
.retry-btn::after { border: 0; }
