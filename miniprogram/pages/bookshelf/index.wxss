/* pages/bookshelf/index.wxss */
.bookshelf-page {
  background-color: #FAF7F0;
  min-height: 100vh;
  position: relative;
}

.bookshelf-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.bookshelf-header {
  position: relative;
  z-index: 1;
  padding: 8rpx 36rpx 4rpx;
}

.header-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title-box {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3D332A;
}

.page-sub {
  font-size: 22rpx;
  color: #7A6F64;
  margin-top: 4rpx;
}

.search-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 1rpx solid #E8DFD3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-svg {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.bookshelf-scroll {
  flex: 1;
  padding: 4rpx 36rpx calc(140rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

.shelf-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx;
}

.book-item {
  width: 216rpx;
  margin-bottom: 20rpx;
}

.book-cover {
  width: 216rpx;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(78, 62, 48, 0.14);
  background-color: #F6F0E6;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.mood-ribbon {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(61, 51, 42, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}

.book-title {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3D332A;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-date {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #ABA094;
  text-align: center;
}

.shelf-board {
  height: 18rpx;
  background: linear-gradient(180deg, #E4D1B5 0%, #D8C2A2 100%);
  border-radius: 6rpx;
  box-shadow: 0 6rpx 12rpx rgba(78, 62, 48, 0.16);
  margin-top: 8rpx;
}

/* 回忆日历子入口卡（书架核心轨道，视觉丰富） */
.shelf-calendar-card {
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #FDF3EB 0%, #F6E9D8 100%);
  border: 1rpx solid #F0D4BE;
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(217, 132, 91, 0.10);
}

.cal-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: #FFFCF8;
  border: 1rpx solid #F0D4BE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cal-svg {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.cal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D332A;
}

.cal-sub {
  font-size: 22rpx;
  color: #8A8077;
  margin-top: 4rpx;
}

.cal-arrow {
  font-size: 44rpx;
  color: #C7A88A;
}

/* 分享广场入口卡 */
.square-entry-card {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #FCFAF6;
  border: 1rpx solid #EFE3D2;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 3rpx 12rpx rgba(61, 51, 42, 0.04);
  opacity: 0.96;
}

.entry-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background-color: #F6F0E6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-svg {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #5A4E42;
}

.entry-sub {
  font-size: 22rpx;
  color: #7A6F64;
  margin-top: 4rpx;
}

.entry-arrow {
  font-size: 44rpx;
  color: #ABA094;
}

/* 空态 / 失败态 */
.empty-shelf {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx 36rpx;
}

.shelf-placeholder-grid {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 36rpx;
  margin-bottom: 0;
}

.book-placeholder {
  width: 220rpx;
  height: 290rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #E0D2C0;
  background-color: rgba(255, 252, 246, 0.65);
  box-shadow: inset 0 2rpx 8rpx rgba(118, 93, 70, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.slot-plus {
  font-size: 32rpx;
  color: #C7B099;
}

.slot-text {
  font-size: 22rpx;
  color: #9C8F82;
  letter-spacing: 1rpx;
}

.placeholder-board {
  width: 100%;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.empty-illust {
  position: relative;
  width: 380rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.empty-dog {
  width: 320rpx;
  height: 240rpx;
}

.empty-z {
  position: absolute;
  top: 6rpx;
  right: 28rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #D9C3A8;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D332A;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7A6F64;
  text-align: center;
  line-height: 1.6;
}

/* 加载失败重试 */
.empty-retry {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #E4A968 0%, #D9845B 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 16rpx 60rpx;
  box-shadow: 0 6rpx 18rpx rgba(217, 132, 91, 0.3);
  transition: transform 0.15s ease;
}

.empty-retry:active {
  transform: scale(0.95);
}
