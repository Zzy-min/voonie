.storage-page { height:100vh; min-height:0; padding-bottom:0; background:#FFF9F1; }
.storage-header { background:#FFFDF8; border-bottom:1rpx solid #EEE3D5; flex:none; }
.storage-nav { display:flex; align-items:center; gap:20rpx; padding-left:24rpx; font-size:30rpx; color:#3E3026; }
.back { width:64rpx; font-size:58rpx; text-align:center; }
.storage-scroll { flex:1; min-height:0; padding:24rpx; box-sizing:border-box; }
.card { padding:30rpx; margin-bottom:24rpx; background:#FFFDF8; border:1rpx solid #EEE3D5; border-radius:24rpx; }
.label,.section-title,.row-title,.note,.empty,.total { display:block; }
.label,.section-title { font-size:28rpx; color:#3E3026; font-weight:600; }
.total { font-size:52rpx; font-weight:600; margin:12rpx 0; color:#BA7B40; }
.note,.empty { font-size:23rpx; line-height:1.65; color:#8D7A69; margin:12rpx 0; }
.metric { display:flex; justify-content:space-between; gap:24rpx; font-size:25rpx; color:#655345; margin:20rpx 0; }
button { font-size:24rpx; line-height:68rpx; color:#78542F; background:#FAE8C9; border-radius:16rpx; }
.row { padding:24rpx 0; border-top:1rpx solid #EEE3D5; margin-top:18rpx; }
.row-title { font-size:27rpx; color:#3E3026; overflow-wrap:anywhere; }
.actions { display:flex; flex-wrap:wrap; gap:16rpx; }
.actions button { margin:0; padding:0 24rpx; }
.error { display:block; padding:16rpx; color:#A04E36; font-size:25rpx; }
