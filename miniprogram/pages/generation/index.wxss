/* pages/generation/index.wxss */
.generation-page {
  box-sizing: border-box;
  background-color: #fff9f1;
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  position: relative;
  overflow-y: auto;
}

.generation-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.generation-nav {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
}

.cancel-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eee3d5;
  border-radius: 32rpx;
  background: rgba(255, 253, 248, 0.94);
  box-sizing: border-box;
}

.cancel-icon {
  font-size: 34rpx;
  line-height: 1;
  color: #7c6a5c;
}

.cancel-text {
  font-size: 24rpx;
  color: #7c6a5c;
}

.generation-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 12rpx;
}

.main-title {
  max-width: 620rpx;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #3e3026;
}

.sub-title {
  font-size: 26rpx;
  color: #7c6a5c;
  margin-top: 10rpx;
}
.draft-preview { position: relative; z-index: 1; margin-top: 18rpx; padding: 22rpx 24rpx; border: 1rpx solid #eee3d5; border-radius: 20rpx; background: rgba(255,253,248,.92); }
.draft-preview-head { display: flex; align-items: center; justify-content: space-between; color: #7c6a5c; font-size: 21rpx; }
.edit-draft { color: #b8752d; font-weight: 600; }
.draft-preview-text { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: #3e3026; font-size: 24rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }

/* 步骤清单卡片 */
.checklist-card {
  background-color: #fffdf8;
  border: 1rpx solid #eee3d5;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(84, 60, 35, 0.06);
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background-color: #FAF7F0;
  border: 1rpx solid #E8DFD3;
  color: #ABA094;
}

.completed .step-icon-wrap {
  background-color: #D9845B;
  border-color: #D9845B;
  color: #FFFFFF;
}

.in-progress .step-icon-wrap {
  background-color: #FDF3EB;
  border-color: #D9845B;
  color: #D9845B;
}

.step-name {
  flex: 1;
  font-size: 28rpx;
  color: #3D332A;
  font-weight: 500;
}

.step-status {
  font-size: 24rpx;
  color: #ABA094;
}

.completed .step-status {
  color: #7A6F64;
}

.highlight {
  color: #D9845B;
  font-weight: 600;
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #FAF7F0;
}

.progress-bar-bg {
  flex: 1;
  height: 12rpx;
  background-color: #FAF7F0;
  border-radius: 9999rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #E4A968 0%, #D9845B 100%);
  border-radius: 9999rpx;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #D9845B;
  width: 60rpx;
  text-align: right;
}

/* 伏案写字的木质桌面场景（对齐案例第5屏） */
.desk-dog-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.desk-scene-img {
  width: 100%;
  height: 410rpx;
  display: block;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(84, 60, 35, 0.08);
}

.desk-caption {
  font-size: 26rpx;
  color: #7A6F64;
  margin-top: 16rpx;
  text-align: center;
  z-index: 1;
}
.desk-dog-area.compact .desk-scene-img { height: 260rpx; }

/* 生成失败错误态 */
.failure-card {
  background: #FFF7F0;
  border: 2rpx solid #F2D8C0;
  border-radius: 28rpx;
  padding: 36rpx;
  margin: 10rpx 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

@media (max-height: 700px) {
  .generation-header {
    padding-top: 12rpx;
  }

  .checklist-card {
    padding-top: 24rpx;
    padding-bottom: 24rpx;
    gap: 14rpx;
  }

  .desk-scene-img {
    height: 300rpx;
  }
}
.failure-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #C26741;
  margin-bottom: 12rpx;
}
.failure-msg {
  font-size: 26rpx;
  color: #7A6F64;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.failure-actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.failure-retry {
  background: #D9845B;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
  margin: 0;
}
.failure-goback {
  font-size: 28rpx;
  color: #7A6F64;
  padding: 16rpx 8rpx;
}
