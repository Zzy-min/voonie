<!-- pages/generation/index.wxml -->
<view class="voonie-page voonie-page--no-tab generation-page">
  <!-- 真实轻纸质温润场景背景切片（对齐案例第5屏） -->
  <image class="generation-bg" src="/assets/images/ui/ui-bg-ai-organize.png" mode="aspectFill" />

  <view style="height: {{statusBarHeight}}px;"></view>

  <view class="generation-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
    <view class="cancel-btn" bindtap="onSkip">
      <text class="cancel-icon">×</text>
      <text class="cancel-text">取消</text>
    </view>
  </view>

  <view class="generation-header">
    <text class="main-title">Vonnie 正在整理你的今天…</text>
    <text class="sub-title">整理完成后，会生成日记和绘本。</text>
  </view>

  <view class="draft-preview" wx:if="{{draftText}}">
    <view class="draft-preview-head"><text>你的原始记录</text><text class="edit-draft" bindtap="onEditDraft">{{canceling ? '正在返回…' : '继续修改'}}</text></view>
    <text class="draft-preview-text">{{draftText}}</text>
  </view>

  <!-- 步骤清单卡片 -->
  <view class="checklist-card">
    <view class="step-item {{step >= 1 ? 'completed' : 'pending'}}">
      <view class="step-icon-wrap">
        <text class="check-mark">{{step >= 1 ? '✓' : '○'}}</text>
      </view>
      <text class="step-name">语音转文字</text>
      <text class="step-status">{{step >= 1 ? '已完成' : '排队中...'}}</text>
    </view>

    <view class="step-item {{step >= 2 ? 'completed' : 'pending'}}">
      <view class="step-icon-wrap">
        <text class="check-mark">{{step >= 2 ? '✓' : '○'}}</text>
      </view>
      <text class="step-name">理解今天发生的事情</text>
      <text class="step-status">{{step >= 2 ? '已完成' : '排队中...'}}</text>
    </view>

    <view class="step-item {{step >= 3 ? 'completed' : 'pending'}}">
      <view class="step-icon-wrap">
        <text class="check-mark">{{step >= 3 ? '✓' : '○'}}</text>
      </view>
      <text class="step-name">整理重要片段</text>
      <text class="step-status">{{step >= 3 ? '已完成' : (step === 2 ? '进行中…' : '排队中...')}}</text>
    </view>

    <view class="step-item {{step >= 4 ? 'completed' : (step === 3 ? 'in-progress' : 'pending')}}">
      <view class="step-icon-wrap">
        <text class="check-mark">{{step >= 4 ? '✓' : (step === 3 ? '•' : '○')}}</text>
      </view>
      <text class="step-name">生成日记</text>
      <text class="step-status {{step === 3 ? 'highlight' : ''}}">{{step >= 4 ? '已完成' : (step === 3 ? '进行中…' : '排队中...')}}</text>
    </view>

    <view class="step-item {{step >= 5 ? 'completed' : (step === 4 ? 'in-progress' : 'pending')}}">
      <view class="step-icon-wrap">
        <text class="check-mark">{{step >= 5 ? '✓' : (step === 4 ? '•' : '○')}}</text>
      </view>
      <text class="step-name">准备绘本</text>
      <text class="step-status {{step === 4 ? 'highlight' : ''}}">{{step >= 5 ? '已完成' : (step === 4 ? '绘制中…' : '排队中...')}}</text>
    </view>

    <!-- 真实进度指示 -->
    <view class="progress-section">
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{percent}}%;"></view>
      </view>
      <text class="progress-text">{{percent}}%</text>
    </view>
  </view>

  <!-- 生成失败错误态（支持重试） -->
  <view class="failure-card" wx:if="{{failed}}">
    <text class="failure-title">这次整理没有完成</text>
    <text class="failure-msg">{{errorMsg}}</text>
    <view class="failure-actions">
      <button class="failure-retry" bindtap="onRetry" wx:if="{{jobId}}">重新生成</button>
      <view class="failure-goback" bindtap="onBack">返回首页</view>
    </view>
  </view>

  <view class="desk-dog-area {{draftText ? 'compact' : ''}}">
    <image class="desk-scene-img" src="/assets/images/voonie/vonnie-writing-desk-hd.jpg" mode="aspectFill" />
    <text class="desk-caption">慢慢来，Vonnie 正在认真整理。</text>
  </view>
</view>
