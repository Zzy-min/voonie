<!-- pages/diary/index.wxml -->
<view class="voonie-page voonie-page--no-tab diary-page">
  <!-- 顶部状态栏与操作 -->
  <view class="diary-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="nav-back-btn" bindtap="onBack">
        <image class="back-icon-svg" src="/assets/icons/icon-back.svg" mode="aspectFit" />
      </view>
      <text class="header-date">{{diary.date_label || (readOnly ? '公开日记' : '今日日记')}}</text>
      <!-- 心情书签 -->
      <view class="mood-bookmark">
        <text class="bookmark-star">★</text>
        <text class="bookmark-text">{{diary.mood || '开心'}}</text>
      </view>
    </view>
  </view>

  <!-- 加载态 -->
  <view class="diary-state" wx:if="{{loading}}">
    <view class="voonie-spinner"></view>
    <text class="diary-state-text">正在翻开手帐…</text>
  </view>

  <!-- 错误态（可重试） -->
  <view class="diary-state" wx:elif="{{failed}}">
    <image class="empty-dog anim-breathe" src="/assets/images/voonie/voonie-sleep.png" mode="aspectFit" />
    <text class="diary-state-title">这一篇没有加载出来</text>
    <text class="diary-state-text">网络出了点小状况，请重试看看 🐾</text>
    <view class="empty-retry" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 空态 -->
  <view class="diary-state" wx:elif="{{!diary}}">
    <text class="diary-state-text">Vonnie 还没有收藏今天的故事。说说今天发生了什么吧。</text>
    <view class="empty-primary" bindtap="onGoRecord">去记录</view>
  </view>

  <!-- 现代数字日记：避免低分辨率书框切片和横向裁切 -->
  <view class="book-container" wx:elif="{{diary}}">
    <scroll-view class="book-paper-content page-turn" scroll-y wx:key="turnKey">
      <view class="book-paper-inner">
      <!-- 日记大标题 -->
      <view class="diary-title-box">
        <text class="share-author" wx:if="{{readOnly}}">{{shareAuthor}} 分享的日记</text>
        <text class="diary-title">{{diary.title || '今天遇见了一只小狗'}}</text>
        <text class="ai-note">部分标题、整理与插图由 AI 辅助生成</text>
      </view>

      <view class="diary-flow">
        <block wx:for="{{contentBlocks}}" wx:key="key">
          <view class="diary-text-paragraph" wx:if="{{item.type === 'text'}}">
            <text>{{item.text}}</text>
          </view>
          <view class="comic-illustration-card" wx:else data-url="{{item.url}}" bindtap="onPreviewImage">
            <image class="comic-img" src="{{item.url}}" mode="aspectFill" />
          </view>
        </block>
      </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部浮动工具栏 -->
  <view class="diary-floating-bar" wx:if="{{diary && !loading && !failed}}">
    <view class="tool-btn" wx:if="{{!readOnly}}" bindtap="onEdit">
      <image class="tool-icon-svg" src="/assets/icons/icon-pen.svg" mode="aspectFit" />
      <text class="tool-label">编辑</text>
    </view>

    <view class="tool-btn" bindtap="onShare">
      <image class="tool-icon-svg" src="/assets/icons/icon-star.svg" mode="aspectFit" />
      <text class="tool-label">{{readOnly ? '分享这篇' : '分享给朋友'}}</text>
    </view>
    <view class="tool-btn danger-tool" wx:if="{{!readOnly}}" bindtap="onDelete">
      <text class="delete-icon">×</text>
      <text class="tool-label">删除</text>
    </view>
  </view>
</view>
