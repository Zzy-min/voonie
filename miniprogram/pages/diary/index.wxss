.diary-page {
  height: 100vh;
  min-height: 0;
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
  background: #FFF9F1;
  overflow: hidden;
}

.diary-header { flex: none; padding: 0 32rpx; background: #FFF9F1; border-bottom: 1rpx solid #EEE3D5; }
.header-nav { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.nav-back-btn { width: 64rpx; height: 64rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.back-icon-svg { width: 34rpx; height: 34rpx; }
.header-date { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; color: #3E3026; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mood-bookmark { flex: none; max-width: 180rpx; padding: 6rpx 16rpx; border: 1rpx solid #F0D4BE; border-radius: 999rpx; display: flex; align-items: center; gap: 6rpx; background: #FFF6E7; }
.bookmark-star { color: #C7842F; font-size: 19rpx; }
.bookmark-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8A5E25; font-size: 21rpx; }

.book-container { flex: 1; min-height: 0; margin: 0; background: #FFFDF8; overflow: hidden; }
.book-paper-content { width: 100%; height: 100%; box-sizing: border-box; }
.book-paper-inner { width: 100%; padding: 42rpx 40rpx 64rpx; box-sizing: border-box; }
.page-turn { transform-origin: center; animation: pageAppear 180ms ease-out; }
@keyframes pageAppear { from { opacity: .35; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }

.diary-title-box { margin-bottom: 24rpx; }
.diary-flow { display: flex; flex-direction: column; }
.share-author { display:block; margin-bottom:12rpx; color:#7C6A5C; font-size:23rpx; }
.diary-title { display: block; padding-left: 18rpx; border-left: 6rpx solid #E8A74C; color: #3E3026; font-size: 38rpx; font-weight: 650; line-height: 1.42; overflow-wrap: anywhere; }
.ai-note { display: block; margin-top: 10rpx; color: #A89789; font-size: 19rpx; }
.danger-tool .tool-label, .delete-icon { color: #A94C38; }
.delete-icon { font-size: 34rpx; line-height: 1; }
.diary-text-paragraph { margin-bottom: 30rpx; color: #3E3026; font-size: 29rpx; line-height: 1.8; text-align: left; overflow-wrap: anywhere; white-space: pre-wrap; }
.comic-illustration-card { width: 100%; height: 0; padding-bottom: 66.67%; margin-bottom: 30rpx; position: relative; overflow: hidden; border-radius: 20rpx; background: #F8F1E8; }
.comic-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

.diary-floating-bar { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); height: 92rpx; padding: 0 12rpx; border: 1rpx solid #EEE3D5; border-radius: 24rpx; box-sizing: border-box; background: #FFFDF8; box-shadow: 0 8rpx 40rpx rgba(84,60,35,.08); display: flex; align-items: center; justify-content: space-around; z-index: 99; }
.tool-btn { min-width: 0; padding: 14rpx 12rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #3E3026; }
.tool-btn:active { transform: scale(.98); }
.tool-arrow { color: #7C6A5C; font-size: 34rpx; line-height: 1; }
.tool-icon-svg { width: 30rpx; height: 30rpx; }
.tool-label { font-size: 23rpx; font-weight: 500; white-space: nowrap; }

.diary-state { flex: 1; padding: 80rpx 60rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.diary-state-title { margin-bottom: 12rpx; color: #3E3026; font-size: 31rpx; font-weight: 650; }
.diary-state-text { margin-top: 16rpx; color: #7C6A5C; font-size: 27rpx; line-height: 1.6; }
.empty-dog { width: 190rpx; height: 190rpx; }
.voonie-spinner { width: 58rpx; height: 58rpx; border: 6rpx solid #F8DCA8; border-top-color: #E8A74C; border-radius: 50%; animation: voonie-rotate 1s linear infinite; }
@keyframes voonie-rotate { to { transform: rotate(360deg); } }
.empty-retry, .empty-primary { margin-top: 32rpx; padding: 16rpx 56rpx; border-radius: 20rpx; background: #E8A74C; color: #3E3026; font-size: 27rpx; font-weight: 600; }
