/* pages/square/index.wxss */
.square-page {
  background-color: #FAF7F0;
  min-height: 100vh;
  position: relative;
}

.square-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.square-header {
  position: relative;
  z-index: 1;
  padding: 0 36rpx;
}

.header-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  position: relative;
  width: 100%;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon-svg {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.square-main-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #3D332A;
  letter-spacing: 1rpx;
  position: absolute;
  left: 200rpx;
  white-space: nowrap;
}

.square-tabs-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.square-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.square-tab-btn {
  font-size: 26rpx;
  color: #7A6F64;
  padding: 8rpx 28rpx;
  border-radius: 9999rpx;
  transition: all 0.2s ease;
}

.square-tab-btn.active {
  background-color: #D9845B;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(217, 132, 91, 0.25);
}

.search-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 1rpx solid #E8DFD3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.square-scroll-body {
  flex: 1;
  padding: 10rpx 36rpx 40rpx;
  position: relative;
  z-index: 1;
}

.square-empty {
  min-height: 760rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 48rpx 100rpx;
  text-align: center;
}

.square-empty-dog {
  width: 280rpx;
  height: 230rpx;
  margin-bottom: 20rpx;
}

.square-empty-title {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #3D332A;
}

.square-empty-copy {
  max-width: 520rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #7A6F64;
}

.square-empty-action {
  margin-top: 36rpx;
  min-width: 360rpx;
  padding: 22rpx 38rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #E09A6C 0%, #D9845B 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(217, 132, 91, 0.22);
}

.square-empty-action:active {
  transform: scale(0.98);
}

/* 动态卡片 */
.feed-card {
  background-color: #FCFAF6;
  border-radius: 32rpx;
  border: 1rpx solid #EFE3D2;
  padding: 30rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(61, 51, 42, 0.05);
}

.feed-user-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feed-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #FAF7F0;
}

.feed-user-meta {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feed-author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D332A;
}

.feed-mood-tag {
  background-color: #FDF3EB;
  color: #D9845B;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.feed-more-btn {
  color: #ABA094;
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.feed-caption {
  font-size: 28rpx;
  line-height: 1.6;
  color: #3D332A;
  margin-bottom: 20rpx;
  display: block;
}

.feed-img-wrap {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #F6F0E6;
  margin-bottom: 24rpx;
}

.feed-img {
  width: 100%;
  height: 100%;
}

.feed-action-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #FAF7F0;
}

.action-stat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #7A6F64;
}

.action-icon {
  font-size: 28rpx;
}

.action-count {
  font-size: 24rpx;
  font-weight: 500;
}

.action-stat.liked .action-count {
  color: #E07A5F;
}
