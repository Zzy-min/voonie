<!-- pages/auth/index.wxml -->
<view class="voonie-page voonie-page--no-tab auth-page">
  <!-- 真实轻纸质/奶油氛围背景切片（对齐案例第1屏） -->
  <image class="auth-bg" src="/assets/images/ui/ui-bg-login.png" mode="aspectFill" />

  <!-- 顶部状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <view class="auth-container">
    <!-- 品牌头部与大号坐姿小狗形象（对齐案例构图比例） -->
    <view class="brand-header">
      <text class="brand-logo">Voling 日记</text>
      <text class="brand-slogan">记录你的每一天</text>
      <view class="dog-sitting-box">
      <image class="dog-sitting-img voonie-mascot voonie-mascot--hero anim-breathe" src="/assets/images/voonie/voonie-sit.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 登录卡片：微信快捷登录优先，手机号授权其次，邮箱作为备用方式。 -->
    <view class="auth-card">
      <view class="welcome-copy">
        <text class="welcome-title">欢迎来到 Voling 日记</text>
        <text class="welcome-sub">让 Vonnie 陪你留住每一个值得记住的日子</text>
      </view>

      <view class="protocol-box protocol-box--primary">
        <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <view class="protocol-text">我已阅读并同意<text class="protocol-link" catchtap="onOpenTerms">《用户协议》</text>和<text class="protocol-link" catchtap="onOpenPrivacy">《隐私政策》</text></view>
      </view>

      <button class="quick-login-btn wechat-primary" loading="{{authAction === 'wechat'}}" disabled="{{authAction !== ''}}" bindtap="onWeChatFastLogin" hover-class="quick-login-btn--pressed">
        <image class="quick-login-icon" src="/assets/icons/icon-wechat.svg" mode="aspectFit" />
        <text>微信快捷登录</text>
      </button>
      <button class="quick-login-btn phone-secondary" open-type="getPhoneNumber" loading="{{authAction === 'phone'}}" disabled="{{authAction !== ''}}" bindgetphonenumber="onPhoneLogin" hover-class="quick-login-btn--pressed">
        <view class="phone-icon">手机</view>
        <text>手机号快捷登录</text>
      </button>
      <text class="privacy-hint">手机号仅用于登录与账号找回，不会展示给其他用户</text>

      <view class="email-entry" bindtap="onToggleEmailForm">
        <view class="email-entry-line"></view>
        <text>{{showEmailForm ? '收起邮箱登录' : '使用邮箱登录或注册'}}</text>
        <view class="email-entry-line"></view>
      </view>

      <view class="email-panel" wx:if="{{showEmailForm}}">
        <view class="auth-segmented">
          <view class="segment-btn {{isLogin ? 'active' : ''}}" bindtap="switchMode" data-mode="login">
            <text>邮箱登录</text>
          </view>
          <view class="segment-btn {{!isLogin ? 'active' : ''}}" bindtap="switchMode" data-mode="register">
            <text>邮箱注册</text>
          </view>
        </view>

        <view class="form-fields">
        <!-- 昵称（仅注册时显示） -->
        <view wx:if="{{!isLogin}}" class="input-group">
          <text class="input-icon">👤</text>
          <input
            class="form-input"
            placeholder="给自己起个温暖的昵称"
            value="{{nickname}}"
            bindinput="onNicknameInput"
            cursor-spacing="16"
          />
        </view>

        <!-- 当前后端仅支持邮箱密码；手机号与 Apple 登录不能用前端按钮伪装。 -->
        <view class="input-group">
          <image class="input-icon-svg" src="/assets/icons/icon-mail.svg" mode="aspectFit" />
          <input
            class="form-input"
            placeholder="邮箱地址"
            value="{{account}}"
            bindinput="onAccountInput"
            cursor-spacing="16"
          />
        </view>

        <!-- 密码与眼睛可见性切换（对齐案例第1屏） -->
        <view class="input-group">
          <image class="input-icon-svg" src="/assets/icons/icon-lock.svg" mode="aspectFit" />
          <input
            class="form-input"
            placeholder="密码"
            password="{{!showPassword}}"
            value="{{password}}"
            bindinput="onPasswordInput"
            cursor-spacing="16"
          />
          <view class="eye-toggle-btn" bindtap="onToggleShowPassword">
            <image class="input-icon-svg eye-icon" src="{{showPassword ? '/assets/icons/icon-eye.svg' : '/assets/icons/icon-eye-off.svg'}}" mode="aspectFit" />
          </view>
        </view>
        </view>

      <!-- 选项与找回密码 -->
        <view wx:if="{{isLogin}}" class="form-extras">
        <view class="remember-box" bindtap="toggleRemember">
          <view class="checkbox {{rememberMe ? 'checked' : ''}}">
            <text wx:if="{{rememberMe}}">✓</text>
          </view>
          <text class="remember-label">记住我</text>
        </view>
        <text class="forget-link" bindtap="onForgetPassword">忘记密码？</text>
        </view>

      <!-- 主提交按钮 -->
        <button class="btn-primary auth-submit-btn" loading="{{loading}}" disabled="{{authAction !== ''}}" bindtap="onSubmit">
          <text>{{isLogin ? '邮箱登录' : '立即注册'}}</text>
        </button>

        <view class="switch-link-row" bindtap="onToggleMode">
          <text class="switch-link-text">{{isLogin ? '还没有邮箱账号？立即注册' : '已有邮箱账号？立即登录'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
