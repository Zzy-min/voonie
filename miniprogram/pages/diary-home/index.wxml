<view class="voonie-page diary-page">
  <view class="diary-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <view><text class="page-title">日记</text><text class="page-sub">Vonnie 帮你留住了这些日子</text></view>
    </view>
  </view>

  <scroll-view class="diary-scroll" scroll-y>
    <view class="module-links">
      <view class="module-link" bindtap="onOpenCalendar">
        <image src="/assets/icons/tab-bookshelf.svg" mode="aspectFit" />
        <view><text class="module-title">回忆日历</text><text class="module-copy">按日期找回记录</text></view><text class="arrow">›</text>
      </view>
      <view class="module-link" bindtap="onOpenBookshelf">
        <image src="/assets/icons/icon-bookshelf.svg" mode="aspectFit" />
        <view><text class="module-title">全部日记与绘本</text><text class="module-copy">浏览完整记录</text></view><text class="arrow">›</text>
      </view>
    </view>

    <view class="section-head"><text class="section-title">最近一篇</text></view>
    <view wx:if="{{loading}}" class="state-panel"><text>正在翻找最近的记录…</text></view>
    <view wx:elif="{{failed}}" class="state-panel">
      <image src="/assets/images/voonie/voonie-sleep.png" mode="aspectFit" />
      <text class="state-title">Vonnie 好像刚刚没听清。</text><text class="state-copy">检查网络后再试一次。</text>
      <button class="secondary-action" bindtap="onRetry">再试一次</button>
    </view>
    <view wx:elif="{{!latest}}" class="state-panel">
      <image src="/assets/images/voonie/voonie-lie.png" mode="aspectFit" />
      <text class="state-title">Vonnie 还没有收藏今天的故事。</text><text class="state-copy">说说今天发生了什么吧。</text>
      <button class="primary-action" bindtap="onOpenRecord">说给 Vonnie 听</button>
    </view>
    <view wx:else class="latest-entry" bindtap="onOpenDiary">
      <image class="latest-cover" src="{{latest.cover || '/assets/images/ui/illust-meadow.png'}}" mode="aspectFill" />
      <view class="latest-meta">
        <text class="latest-date">{{latest.date_label}}</text>
        <text class="latest-title">{{latest.title}}</text>
        <text class="latest-mood">{{latest.mood}}</text>
        <text class="latest-summary">{{latest.summary || latest.full_content}}</text>
        <text class="read-link">阅读日记 ›</text>
      </view>
    </view>

    <button class="new-entry" bindtap="onOpenRecord"><image src="/assets/icons/icon-mic.svg" mode="aspectFit" /><text>记录今天</text></button>
  </scroll-view>
</view>
