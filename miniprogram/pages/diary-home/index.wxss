/* pages/diary-home/index.wxss - 日记 Tab 根页（手帐封面） */
.journal-page {
  background-color: #FAF7F0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  padding-left: 40rpx;
  padding-right: 40rpx;
  position: relative;
}

.journal-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.journal-header {
  position: relative;
  z-index: 1;
  padding: 10rpx 0 20rpx;
}

.header-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title-box {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3D332A;
  letter-spacing: 2rpx;
}

.page-sub {
  font-size: 22rpx;
  color: #7A6F64;
  margin-top: 4rpx;
}

.calendar-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #FFFCF8;
  border: 1rpx solid #E8DFD3;
  border-radius: 9999rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(118, 93, 70, 0.05);
}

.cal-link-svg {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.calendar-link-text {
  font-size: 24rpx;
  color: #7A6F64;
  font-weight: 500;
}

/* 状态区（加载/失败/空态） */
.journal-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 28rpx 12rpx 40rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}
.journal-state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #C26741;
  margin-bottom: 12rpx;
}
.journal-state-text {
  font-size: 28rpx;
  color: #7A6F64;
  line-height: 1.6;
  margin-top: 24rpx;
}
.empty-dog {
  width: 200rpx;
  height: 200rpx;
}
.voonie-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #F2D8C0;
  border-top-color: #D9845B;
  border-radius: 50%;
  animation: voonie-rotate 1s linear infinite;
}
@keyframes voonie-rotate {
  to { transform: rotate(360deg); }
}

/* 空态：Voonie 陪伴图 */
.journal-empty-figure {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}
.journal-empty-dog {
  width: 360rpx;
  height: 215rpx;
}

/* 空态：空白笔记本封面 */
.empty-cover {
  position: relative;
  width: 600rpx;
  background-color: #FCFAF6;
  background-image:
    linear-gradient(rgba(129, 152, 117, 0.10) 1rpx, transparent 1rpx);
  background-size: 100% 48rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4D5C3;
  box-shadow:
    0 14rpx 40rpx rgba(78, 62, 48, 0.11),
    inset 0 0 0 1rpx rgba(255, 252, 246, 0.8);
  padding: 72rpx 48rpx 88rpx 76rpx;
  margin-bottom: 28rpx;
}
.empty-cover::before {
  /* 左侧装订脊 */
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 18rpx;
  background: linear-gradient(90deg, #E8D9C4 0%, #F3E9D8 100%);
  border-radius: 12rpx 0 0 12rpx;
  z-index: 2;
}

.empty-cover-rings {
  position: absolute;
  left: 6rpx;
  top: 70rpx;
  bottom: 70rpx;
  width: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  z-index: 5;
}

.ring-hole {
  width: 22rpx;
  height: 22rpx;
  background: radial-gradient(circle at 35% 35%, #F5EDE0 0%, #C9B59A 55%, #A89072 100%);
  border-radius: 50%;
  box-shadow:
    inset 0 2rpx 3rpx rgba(255,255,255,0.55),
    inset 0 -2rpx 3rpx rgba(80, 60, 40, 0.25),
    0 1rpx 2rpx rgba(61,51,42,0.12);
  border: 2rpx solid #B9A288;
}

.empty-cover-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #3D332A;
  letter-spacing: 3rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

.empty-cover-sub {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8A8077;
  text-align: left;
}

/* 有最近一篇：封面预览卡 */
.journal-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 40rpx;
  position: relative;
  z-index: 1;
}

.journal-cover-card {
  position: relative;
  width: 560rpx;
  background: linear-gradient(160deg, #FCFAF6 0%, #F6F0E6 100%);
  border-radius: 28rpx;
  border: 2rpx solid #E4D5C3;
  box-shadow: 0 16rpx 44rpx rgba(78, 62, 48, 0.14);
  overflow: hidden;
  margin-bottom: 28rpx;
  /* Reserve the footer handle's full height so it never overlays the summary. */
  padding: 36rpx 36rpx 86rpx 64rpx;
}

.cover-spine-rings {
  position: absolute;
  left: 8rpx;
  top: 50rpx;
  bottom: 50rpx;
  width: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  z-index: 5;
}

.cover-inside {
  display: flex;
  flex-direction: column;
}

.cover-date {
  font-size: 24rpx;
  color: #D9845B;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.cover-illust {
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(61, 51, 42, 0.08);
  margin-bottom: 24rpx;
}

.cover-illust-img {
  width: 100%;
  height: 100%;
}

.cover-mood-row {
  margin-bottom: 16rpx;
}

.cover-mood-pill {
  display: inline-flex;
  padding: 6rpx 22rpx;
  border-radius: 9999rpx;
  background-color: #FDF3EB;
  color: #D9845B;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid #F0D4BE;
}

.cover-title-box {
  margin-bottom: 12rpx;
}

.cover-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D332A;
  line-height: 1.4;
  letter-spacing: 2rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

.cover-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: #7A6F64;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.cover-open-handle {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 14rpx 0;
  background: linear-gradient(90deg, rgba(217, 132, 91, 0.06), rgba(217, 132, 91, 0.12));
  border-top: 1rpx solid rgba(217, 132, 91, 0.12);
  text-align: center;
}

.cover-open-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #C26741;
}

/* 主按钮（暖橙大圆角） */
.journal-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  max-width: 600rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #E09A6C 0%, #D9845B 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(217, 132, 91, 0.22);
  border: none;
}

.journal-primary:active {
  transform: scale(0.98);
}

.btn-icon-svg {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.journal-primary-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 次要入口软按钮 */
.journal-secondary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 14rpx 36rpx;
  border-radius: 9999rpx;
  background-color: #FFFCF8;
  border: 1rpx solid #E8DFD3;
  box-shadow: 0 4rpx 14rpx rgba(118, 93, 70, 0.05);
}

.journal-secondary:active {
  transform: scale(0.97);
}

.journal-secondary-sym {
  font-size: 28rpx;
}

.journal-secondary-text {
  font-size: 26rpx;
  color: #7A6F64;
  font-weight: 500;
}

.journal-retry {
  margin-top: 36rpx;
  background: #D9845B;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 64rpx;
}
