<!-- pages/profile/index.wxml -->
<view class="voonie-page profile-page">
  <!-- 柔和纸质背景切片（对齐案例第8屏） -->
  <image class="profile-bg" src="/assets/images/ui/ui-bg-profile.png" mode="aspectFill" />

  <!-- 顶部状态栏 -->
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <scroll-view class="profile-scroll" scroll-y>
    <!-- 用户个人信息头部 -->
    <view class="user-header-card">
      <view class="user-info-row">
        <view class="avatar-wrap" bindtap="onEditProfile">
      <image class="user-avatar" src="/assets/images/voonie/voonie-avatar.png" mode="aspectFill" />
          <view class="avatar-edit-badge">✎</view>
        </view>
        <view class="user-meta">
          <view class="nickname-box">
            <text class="user-nickname">{{nickname}}</text>
            <text class="edit-icon">✎</text>
          </view>
          <text class="companion-days">Vonnie 陪你记录了 {{companionDays}} 天</text>
        </view>
        <view class="settings-gear-btn" bindtap="onOpenSettings">
          <image class="gear-icon-svg" src="/assets/icons/icon-gear.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 核心统计数据三个小方块（对齐案例第8屏） -->
      <view class="stats-row">
        <view class="stat-box" bindtap="onNavDiaries">
          <text class="stat-num">{{diaryCount}}</text>
          <text class="stat-text">日记</text>
        </view>

        <view class="stat-box" bindtap="onNavComics">
          <text class="stat-num">{{comicCount}}</text>
          <text class="stat-text">绘本</text>
        </view>

        <view class="stat-box">
          <text class="stat-num">{{voiceDays}}</text>
          <text class="stat-text">记录天数</text>
        </view>
      </view>
    </view>

    <!-- 快捷功能入口三张手帐图样卡片（对齐案例第8屏：我的日记 / 我的绘本 / 时光碎片） -->
    <view class="shortcut-cards-row">
      <view class="shortcut-card" bindtap="onNavDiaries">
      <image class="shortcut-thumb-img" src="/assets/icons/tab-diary.svg" mode="aspectFit" />
        <text class="shortcut-title">我的日记</text>
      </view>

      <view class="shortcut-card" bindtap="onNavComics">
      <image class="shortcut-thumb-img" src="/assets/icons/icon-bookshelf.svg" mode="aspectFit" />
        <text class="shortcut-title">我的绘本</text>
      </view>

      <view class="shortcut-card" bindtap="onNavCalendar">
      <image class="shortcut-thumb-img" src="/assets/icons/tab-bookshelf.svg" mode="aspectFit" />
        <text class="shortcut-title">时光碎片</text>
      </view>
    </view>

    <!-- 设置与服务列表卡片 -->
    <view class="menu-list-card">
      <view class="menu-item" bindtap="onNavAccountSecurity">
        <image class="menu-icon-svg" src="/assets/icons/icon-lock.svg" mode="aspectFit" />
        <text class="menu-label">账号与安全</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavCharacters">
        <image class="menu-icon-svg" src="/assets/icons/tab-profile.svg" mode="aspectFit" />
        <text class="menu-label">我的角色集</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavMyShares">
        <image class="menu-icon-svg" src="/assets/icons/icon-search.svg" mode="aspectFit" />
        <text class="menu-label">我的公开分享</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavFeedback">
        <image class="menu-icon-svg" src="/assets/icons/icon-help.svg" mode="aspectFit" />
        <text class="menu-label">帮助与反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavPrivacy">
        <image class="menu-icon-svg" src="/assets/icons/icon-lock.svg" mode="aspectFit" />
        <text class="menu-label">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavTerms">
        <image class="menu-icon-svg" src="/assets/icons/icon-shield.svg" mode="aspectFit" />
        <text class="menu-label">用户服务协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item logout-item" bindtap="onLogout">
        <image class="menu-icon-svg" src="/assets/icons/icon-logout.svg" mode="aspectFit" />
        <text class="menu-label">退出当前账号</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </scroll-view>

</view>
