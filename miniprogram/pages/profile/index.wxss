/* pages/profile/index.wxss */
.profile-page {
  background-color: #FAF7F0;
  min-height: 100vh;
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.profile-scroll {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: 16rpx 32rpx calc(130rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* 顶部用户卡片 */
.user-header-card {
  background-color: #FCFAF6;
  border-radius: 36rpx;
  border: 1rpx solid #E8DFD3;
  padding: 24rpx 28rpx 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(61, 51, 42, 0.05);
  margin-bottom: 20rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #FAF7F0;
  border: 4rpx solid #FFFCF8;
  box-shadow: 0 0 0 8rpx rgba(217, 132, 91, 0.10), 0 4rpx 16rpx rgba(61, 51, 42, 0.08);
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #D9845B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border: 2rpx solid #FFFFFF;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.nickname-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #3D332A;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-icon {
  font-size: 24rpx;
  color: #ABA094;
}

.companion-days {
  font-size: 24rpx;
  color: #7A6F64;
  margin-top: 8rpx;
  display: block;
}

.settings-gear-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gear-icon-svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.65;
}

/* 核心统计数据行 */
.stats-row {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #FAF7F0;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #3D332A;
  line-height: 1.2;
}

.stat-text {
  font-size: 22rpx;
  color: #7A6F64;
}

/* 快捷入口三卡片 */
.shortcut-cards-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.shortcut-card {
  flex: 1;
  background-color: #FCFAF6;
  border: 1rpx solid #EFE3D2;
  border-radius: 28rpx;
  padding: 18rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(118, 93, 70, 0.05);
}

.shortcut-thumb-img {
  width: 52rpx;
  height: 52rpx;
  display: block;
  margin-bottom: 10rpx;
  opacity: 0.78;
}

.shortcut-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #3D332A;
}

/* 菜单列表卡片（右侧预留空间，让位右下角坐书小狗） */
.menu-list-card {
  background-color: #FCFAF6;
  border: 1rpx solid #EFE3D2;
  border-radius: 36rpx;
  padding: 8rpx 28rpx;
  padding-right: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(61, 51, 42, 0.05);
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #FAF7F0;
  gap: 16rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
  opacity: 0.75;
}

.menu-label {
  flex: 1;
  font-size: 26rpx;
  color: #3D332A;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ABA094;
}

.logout-item .menu-label {
  color: #C26741;
}
