.chat-page { height: 100vh; min-height: 0; padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); background: #FFF9F1; overflow: hidden; }
.chat-header { background: #FFFDF8; border-bottom: 1rpx solid #EEE3D5; }
.header-nav { padding-left: 40rpx; display: flex; align-items: center; gap: 18rpx; }
.header-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F8DCA8; }
.header-copy { min-width: 0; }
.header-title, .header-sub { display: block; }
.header-title { font-size: 30rpx; font-weight: 650; color: #3E3026; }
.header-sub { margin-top: 2rpx; font-size: 21rpx; color: #7C6A5C; }
.messages { flex: 1; width: 100%; min-height: 0; padding: 28rpx 32rpx 190rpx; box-sizing: border-box; }
.day-label { margin-bottom: 30rpx; text-align: center; font-size: 21rpx; color: #A89789; }
.message { display: flex; align-items: flex-end; margin-bottom: 24rpx; }
.vonnie-message { gap: 12rpx; padding-right: 80rpx; }
.user-message { justify-content: flex-end; padding-left: 80rpx; }
.message-avatar { width: 52rpx; height: 52rpx; flex: none; border-radius: 50%; background: #F8DCA8; }
.bubble { max-width: 100%; padding: 20rpx 24rpx; border-radius: 24rpx; font-size: 27rpx; line-height: 1.58; word-break: break-word; }
.vonnie-bubble { border-bottom-left-radius: 8rpx; background: #FFFDF8; border: 1rpx solid #EEE3D5; color: #3E3026; }
.user-bubble { border-bottom-right-radius: 8rpx; background: #F8E7C8; color: #3E3026; }
.thinking { color: #7C6A5C; }
.composer-wrap { position: fixed; left: 0; right: 0; bottom: calc(112rpx + env(safe-area-inset-bottom)); z-index: 1000; width: 100%; padding: 12rpx 24rpx 18rpx; box-sizing: border-box; background: #FFFDF8; border-top: 1rpx solid #EEE3D5; transition: bottom 120ms ease-out; }
.composer-wrap.keyboard-open { padding-bottom: 12rpx; box-shadow: 0 -8rpx 30rpx rgba(84, 60, 35, 0.06); }
.quick-prompts { width: 100%; margin-bottom: 12rpx; white-space: nowrap; }
.quick-row { display: inline-flex; gap: 12rpx; }
.quick-chip { height: 58rpx; padding: 0 24rpx; border: 1rpx solid #EEE3D5; border-radius: 999rpx; background: #FFFDF8; color: #7C6A5C; font-size: 23rpx; line-height: 58rpx; }
.composer { min-height: 82rpx; display: flex; align-items: center; gap: 12rpx; }
.voice-button { width: 72rpx; height: 72rpx; flex: none; border-radius: 50%; background: #F8F1E8; display: flex; align-items: center; justify-content: center; }
.voice-button image { width: 34rpx; height: 34rpx; }
.chat-input { flex: 1; width: 0; min-width: 0; height: 72rpx; padding: 0 24rpx; border-radius: 20rpx; background: #F8F1E8; color: #3E3026; font-size: 27rpx; }
.chat-placeholder { color: #A89789; }
.send-button { width: 92rpx; height: 72rpx; flex: none; border-radius: 20rpx; background: #EEE3D5; color: #A89789; font-size: 25rpx; line-height: 72rpx; text-align: center; }
.send-button.active { background: #E8A74C; color: #3E3026; }
