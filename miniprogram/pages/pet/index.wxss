/* pages/pet/index.wxss — 对齐案例第3屏：半屏浮动聊天卡 + 探头小狗舞台 */
.pet-page {
  background-color: #FAF7F0;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

.pet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.pet-header {
  position: relative;
  z-index: 10;
  padding: 12rpx 36rpx 4rpx;
  flex-shrink: 0;
}

.header-nav {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D332A;
  letter-spacing: 1rpx;
}

.bookshelf-link {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #FFFCF8;
  border: 1rpx solid #E8DFD3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(118, 93, 70, 0.05);
}

.bookshelf-svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

/* 探头小狗舞台（小爪贴合在下方聊天卡的上边缘） */
.pet-peeker-stage {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  height: 280rpx;
  position: relative;
  z-index: 5;
  margin-bottom: -32rpx;
  flex-shrink: 0;
}

.pet-peeker-img {
  width: 380rpx;
  height: 270rpx;
  display: block;
}

/* 案例式浮动圆角半屏聊天卡 */
.pet-chat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #FFFCF8;
  border: 2rpx solid #EFE3D2;
  border-bottom: none;
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(61, 51, 42, 0.08);
  position: relative;
  z-index: 2;
  overflow: hidden;
  margin: 0 16rpx;
}

.chat-card-header {
  padding: 24rpx 36rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #FAF7F0;
  flex-shrink: 0;
}

.card-title-box {
  display: flex;
  flex-direction: column;
}

.card-title-main {
  font-size: 34rpx;
  font-weight: bold;
  color: #3D332A;
}

.card-title-sub-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.card-lock-icon {
  font-size: 20rpx;
}

.card-sub-text {
  font-size: 22rpx;
  color: #8C7D73;
}

.card-status-pill {
  font-size: 20rpx;
  color: #D9845B;
  font-weight: 500;
}

.chat-messages {
  flex: 1;
  height: 0;
  min-height: 200rpx;
  padding: 16rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #F6F0E6;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 76%;
  padding: 18rpx 26rpx;
  border-radius: 26rpx;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-word;
}

.pet-bubble {
  background-color: #FFFDF8;
  color: #3D332A;
  border: 1rpx solid #EFE3D2;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(118, 93, 70, 0.04);
}

.user-msg {
  justify-content: flex-end;
}

.user-bubble {
  background-color: #FBE7D0;
  color: #5A4633;
  border: 1rpx solid #F3D5B4;
  border-top-right-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(217, 132, 91, 0.06);
}

.thinking {
  color: #7A6F64;
  font-style: italic;
}

/* 快捷 Chips（对齐案例第3屏：居中三胶囊） */
.quick-tags {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  padding: 10rpx 24rpx 14rpx;
  flex-shrink: 0;
}

.tag-chip {
  background-color: #FFFDF9;
  border: 1.5rpx solid #E8DFD3;
  border-radius: 9999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #7A6F64;
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(61, 51, 42, 0.04);
}

.chip-icon {
  font-size: 22rpx;
  color: #C26741;
}

.tag-chip:active {
  background-color: #FDF3EB;
  color: #D9845B;
  border-color: #F0D4BE;
}

/* 输入条：胶囊输入框 + 独立圆形麦克风（深咖） + 独立圆形发送（橙） */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  gap: 14rpx;
  flex-shrink: 0;
  background-color: #FFFCF8;
  border-top: 1rpx solid #F4EDE4;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  background-color: #FBF8F2;
  border: 1.5rpx solid #E8DFD3;
  border-radius: 9999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #3D332A;
}

.chat-input-placeholder {
  color: #ABA094;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #432E1E; /* 案例深咖色圆形按键 */
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #362315;
  box-shadow: 0 4rpx 12rpx rgba(67, 46, 30, 0.25);
  flex-shrink: 0;
}

.voice-btn:active {
  transform: scale(0.92);
}

.voice-icon-svg {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #D9845B; /* 案例橙色圆形发送键 */
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(217, 132, 91, 0.25);
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.send-arrow {
  font-size: 28rpx;
  font-weight: bold;
}
/* ===== 萌宠状态条（来自 /pet/status） ===== */
.pet-status-strip {
  margin: 0 32rpx 10rpx;
  padding: 8rpx 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFFCF8 0%, #FDF3EB 100%);
  border: 1rpx solid #F0D4BE;
  border-radius: 999rpx;
  align-self: center;
  box-shadow: 0 3rpx 10rpx rgba(217, 132, 91, 0.08);
}
.pet-status-dot {
  font-size: 18rpx;
  color: #E09A6C;
}
.pet-status-text {
  font-size: 22rpx;
  color: #8A6A52;
}

/* ===== 记得的小事（来自 /pet/memories） ===== */
.memories-card {
  margin: 4rpx 24rpx 16rpx 72rpx;
  padding: 20rpx 24rpx;
  background-color: #FFF8F0;
  border: 1rpx solid #F0D4BE;
  border-radius: 22rpx;
  box-shadow: 0 3rpx 12rpx rgba(217, 132, 91, 0.06);
}
.memories-head {
  margin-bottom: 10rpx;
}
.memories-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #C26741;
}
.memories-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 10rpx;
}
.memories-bullet {
  color: #D9845B;
  font-size: 22rpx;
  line-height: 1.6;
}
.memories-text {
  font-size: 24rpx;
  color: #3D332A;
  line-height: 1.6;
}
.memories-empty-body {
  font-size: 24rpx;
  color: #7A6F64;
  line-height: 1.7;
}
