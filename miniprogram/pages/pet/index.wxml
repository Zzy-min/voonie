<view class="voonie-page chat-page">
  <view class="chat-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <image class="header-avatar" src="/assets/images/voonie/voonie-avatar.png" mode="aspectFill" />
      <view class="header-copy"><text class="header-title">和 Vonnie 聊天</text><text class="header-sub">陪你听一会儿{{petStatusLabel ? ' · ' + petStatusLabel : ''}}</text></view>
    </view>
  </view>

  <scroll-view class="messages" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view class="day-label">{{dateLabel}}</view>
    <view class="message vonnie-message">
      <image class="message-avatar" src="/assets/images/voonie/voonie-avatar.png" mode="aspectFill" />
      <view class="bubble vonnie-bubble"><text>{{greeting}}</text></view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view class="message user-message" wx:if="{{item.role === 'user'}}"><view class="bubble user-bubble"><text>{{item.content}}</text></view></view>
      <view class="message vonnie-message" wx:else><image class="message-avatar" src="/assets/images/voonie/voonie-avatar.png" mode="aspectFill" /><view class="bubble vonnie-bubble"><text>{{item.content}}</text></view></view>
    </block>
    <view wx:if="{{loading}}" class="message vonnie-message"><image class="message-avatar" src="/assets/images/voonie/voonie-avatar.png" mode="aspectFill" /><view class="bubble vonnie-bubble thinking"><text>Vonnie 正在想你说的话…</text></view></view>
  </scroll-view>

  <view class="composer-wrap {{keyboardHeight > 0 ? 'keyboard-open' : ''}}" style="{{composerStyle}}">
    <scroll-view class="quick-prompts" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="quick-row">
        <view class="quick-chip" bindtap="onSelectTag" data-text="今天有点累，陪我聊聊吧">陪我聊聊</view>
        <view class="quick-chip" bindtap="onSelectTag" data-text="今天发生了一件开心的事">今天很开心</view>
        <view class="quick-chip" bindtap="onChipWriteDiary">写成日记</view>
      </view>
    </scroll-view>
    <view class="composer">
      <view class="voice-button" bindtap="onChipWriteDiary" aria-role="button" aria-label="语音记录"><image src="/assets/icons/icon-mic.svg" mode="aspectFit" /></view>
      <input class="chat-input" placeholder="说点什么…" placeholder-class="chat-placeholder" value="{{inputValue}}" bindinput="onInput" bindconfirm="onSend" bindkeyboardheightchange="onKeyboardHeightChange" bindblur="onInputBlur" confirm-type="send" adjust-position="{{false}}" cursor-spacing="12" />
      <view class="send-button {{inputValue && !loading ? 'active' : ''}}" bindtap="onSend" aria-role="button">发送</view>
    </view>
  </view>
</view>
