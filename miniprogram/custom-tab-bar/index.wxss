.tab-bar-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 248, 0.98);
  border-top: 1rpx solid #EEE3D5;
}

.tab-bar {
  height: 112rpx;
  display: flex;
  align-items: stretch;
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #A89789;
  transition: color 120ms ease, transform 120ms ease;
}

.tab-item:active { transform: scale(0.98); }
.tab-item.active { color: #C7842F; }

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.tab-label {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}

.tab-item.active .tab-label { font-weight: 600; }
