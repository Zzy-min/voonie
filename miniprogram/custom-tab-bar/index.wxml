<!-- custom-tab-bar/index.wxml -->
<view wx:if="{{!hidden}}" class="tab-bar-container">
  <view class="tab-bar">
    <!-- 1. 首页 -->
    <view class="tab-item {{selected === 0 ? 'active' : ''}}" data-index="0" data-path="/pages/index/index" bindtap="switchTab">
      <view class="tab-icon">
        <image class="tab-icon-img" src="{{selected === 0 ? '/assets/icons/tab-home-active.svg' : '/assets/icons/tab-home.svg'}}" mode="aspectFit" />
      </view>
      <text class="tab-label">首页</text>
    </view>

    <view class="tab-item {{selected === 1 ? 'active' : ''}}" data-index="1" data-path="/pages/diary-home/index" bindtap="switchTab">
      <view class="tab-icon">
        <image class="tab-icon-img" src="{{selected === 1 ? '/assets/icons/tab-diary-active.svg' : '/assets/icons/tab-diary.svg'}}" mode="aspectFit" />
      </view>
      <text class="tab-label">日记</text>
    </view>

    <view class="tab-item {{selected === 2 ? 'active' : ''}}" data-index="2" data-path="/pages/pet/index" bindtap="switchTab">
      <view class="tab-icon">
        <image class="tab-icon-img" src="{{selected === 2 ? '/assets/icons/tab-pet-active.svg' : '/assets/icons/tab-pet-default.svg'}}" mode="aspectFit" />
      </view>
      <text class="tab-label">萌宠</text>
    </view>

    <view class="tab-item {{selected === 3 ? 'active' : ''}}" data-index="3" data-path="/pages/square/index" bindtap="switchTab">
      <view class="tab-icon">
        <image class="tab-icon-img" src="{{selected === 3 ? '/assets/icons/tab-bookshelf-active.svg' : '/assets/icons/tab-bookshelf.svg'}}" mode="aspectFit" />
      </view>
      <text class="tab-label">广场</text>
    </view>

    <!-- 5. 我的 -->
    <view class="tab-item {{selected === 4 ? 'active' : ''}}" data-index="4" data-path="/pages/profile/index" bindtap="switchTab">
      <view class="tab-icon">
        <image class="tab-icon-img" src="{{selected === 4 ? '/assets/icons/tab-profile-active.svg' : '/assets/icons/tab-profile.svg'}}" mode="aspectFit" />
      </view>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
